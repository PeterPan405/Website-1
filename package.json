{
  "name": "im-invests",
  "version": "0.1.0",
  "private": true,
  "description": "IM Invests \u2013 deutschsprachige Finanzbildungs-Plattform (Next.js App Router)",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/version.mjs && npm run kurselive",
    "kurselive": "node --experimental-strip-types scripts/kurse-live-schreiben.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/tests-ausfuehren.mjs",
    "kurse": "node --experimental-strip-types scripts/kurse-abrufen.ts",
    "laender": "node --experimental-strip-types scripts/laender-abrufen.ts",
    "globus-geometrie": "node --experimental-strip-types scripts/globus-geometrie.ts",
    "aktien": "node --experimental-strip-types scripts/aktien-erzeugen.ts && prettier --write --log-level warn data/markets-aktien.ts",
    "fundamentaldaten": "node --experimental-strip-types scripts/fundamentaldaten-abrufen.ts",
    "quartalstermine": "node --experimental-strip-types --import ./scripts/alias-hook.mjs scripts/quartalstermine-abrufen.ts",
    "pruefen": "node --experimental-strip-types scripts/paket-pruefen.ts",
    "frische": "node --experimental-strip-types scripts/frische-pruefen.ts",
    "inhalte": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/inhalte-pruefen.ts",
    "vertraege": "node --experimental-strip-types scripts/vertraege-pruefen.ts",
    "quellenprobe": "node --experimental-strip-types scripts/quellen-pruefen.ts",
    "esef": "node --experimental-strip-types scripts/esef-abrufen.ts",
    "taiwan": "node --experimental-strip-types scripts/taiwan-abrufen.ts",
    "abdeckung": "node --experimental-strip-types --import ./scripts/alias-hook.mjs scripts/abdeckung.ts",
    "dart": "node --experimental-strip-types scripts/dart-abrufen.ts",
    "edinet": "node --experimental-strip-types scripts/edinet-abrufen.ts",
    "podcast": "node --experimental-strip-types scripts/podcast-abrufen.ts",
    "folge": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-folge-erzeugen.ts",
    "instagram": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/instagram-veroeffentlichen.ts",
    "vertonen": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-vertonen.ts",
    "youtube": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-youtube.ts",
    "spotifylinks": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-spotify.ts",
    "podcastfeed": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-feed-schreiben.ts",
    "uebernehmen": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-uebernehmen.ts",
    "instazugang": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/instagram-zugang.ts",
    "videos": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-videos-auflisten.ts",
    "hinweis": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-hook.mjs scripts/podcast-hinweis-angleichen.ts",
    "zuruecknehmen": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/podcast-zuruecknehmen.ts",
    "marktbreite": "node --experimental-strip-types scripts/marktbreite-nachtragen.ts",
    "zinsen": "node --experimental-strip-types scripts/zinsen-abrufen.ts",
    "breite": "node scripts/breite-pruefen.mjs",
    "kontrast": "node scripts/kontrast-pruefen.mjs",
    "druck": "node scripts/druck-pruefen.mjs",
    "verwaist": "node --experimental-strip-types scripts/verwaist-pruefen.ts",
    "gewicht": "node scripts/gewicht-pruefen.mjs",
    "tastatur": "node scripts/tastatur-pruefen.mjs",
    "bilder": "node scripts/referenzbilder.mjs",
    "register-hinweis": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-hook.mjs scripts/podcast-register-angleichen.ts",
    "aenderungen": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/aenderungen-vorschlagen.ts",
    "zahlen": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/alias-hook.mjs scripts/zahlen-pruefen.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  }
}
